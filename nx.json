{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    "./plugins/nx-repro-plugin"
  ],
  "targetDefaults": {
    "dev": {
      "continuous": true
    }
  },
  "nxCloudAccessToken": "",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "packages"
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": []
      }
    }
  },
  "analytics": false
}